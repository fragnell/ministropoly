# Copia questo file in ".env" e compila i valori del TUO progetto Firebase.
# (Firebase console → Impostazioni progetto → Le tue app → App web → Configurazione SDK)
# Servono SOLO per la modalità "Online (Firebase)". La demo locale e la rete locale non ne hanno bisogno.
#
# Nota: la configurazione Web di Firebase non è un segreto (viene comunque inviata al browser);
# la sicurezza dei dati è garantita dalle regole del database (database.rules.json).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Facoltativo: cambia il nome del gioco senza modificare il codice (es. PREDICANDOPOLY)
# VITE_GAME_NAME=MINISTROPOLY

# Facoltativo: usa gli emulatori Firebase locali (vedi README, sezione "Provare Firebase in locale")
# VITE_FIREBASE_USE_EMULATOR=1

# Facoltativo: percorso di pubblicazione (GitHub Pages in una sottocartella: /nome-repository/)
# VITE_BASE=./
